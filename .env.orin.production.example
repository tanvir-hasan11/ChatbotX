PORT=3123
NODE_ENV=production

# ── ORIN (rebranded ChatbotX) ───────────────────────────────
# Community edition — no license needed
NEXT_PUBLIC_EDITION=community

# Platform admin (login email that can access /manage)
PLATFORM_ADMIN_EMAIL=admin@stratmarkbd.com

# ── Auth ────────────────────────────────────────────────────
# Generate your own: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32_
BETTER_AUTH_URL=https://orin.stratmarkbd.com

# ── Encryption ──────────────────────────────────────────────
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32_

# ── Database (postgres runs in docker-compose) ─────────────
DATABASE_URL=postgresql://orin:CHANGE_ME_DB_PASSWORD@postgres:5432/orin?schema=public

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── JavaScript Executor (internal) ─────────────────────────
JAVASCRIPT_EXECUTOR_URL=http://javascript-executor:3210
JAVASCRIPT_EXECUTOR_TOKEN=CHANGE_ME_MIN_32_CHAR_RANDOM_STRING_

# ── S3 (RustFS runs in docker-compose) ─────────────────────
S3_ACCESS_KEY_ID=orin
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET
S3_BUCKET=orin
S3_REGION=us-west-2
S3_ENDPOINT=http://filesystem:9000

# ── SMTP (cPanel email or any provider) ────────────────────
SMTP_SERVER=smtp://user:pass@smtp.stratmarkbd.com:587
SMTP_FROM=no-reply@stratmarkbd.com

# ── Realtime ───────────────────────────────────────────────
REALTIME_BROADCAST_SECRET=CHANGE_ME_RANDOM_SECRET

# ── Public URLs ────────────────────────────────────────────
NEXT_PUBLIC_BUILDER_URL=https://orin.stratmarkbd.com
FORCE_PUBLIC_HTTPS=true

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DEBUG=false

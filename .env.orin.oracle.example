# ─────────────────────────────────────────────────────────────
# ORIN — single-host Oracle Cloud production env
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill every CHANGE_ME.  Generate the secrets
# on the VM with the commands shown next to each one.
#
#   cp .env.orin.oracle.example .env
#   nano .env
#   docker compose -f docker-compose.orin.yml up -d --build
# ─────────────────────────────────────────────────────────────

# ── Domain ───────────────────────────────────────────────────
# Must already resolve (A record) to this VM's public IP before
# `docker compose up`, otherwise Caddy's ACME challenge fails.
ORIN_DOMAIN=orin.stratmarkbd.com

# ── Edition / admin ──────────────────────────────────────────
NEXT_PUBLIC_EDITION=community
# The email you will sign up with. It gets access to /manage.
PLATFORM_ADMIN_EMAIL=CHANGE_ME_your@email.com

# ── Auth ─────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
BETTER_AUTH_URL=https://orin.stratmarkbd.com

# ── Encryption ───────────────────────────────────────────────
# openssl rand -hex 32   ← MUST be exactly 64 hex chars (0-9 a-f)
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# ── Postgres (runs in this compose) ─────────────────────────
POSTGRES_DB=orin
POSTGRES_USER=orin
# openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME_db_password
DATABASE_URL=postgresql://orin:CHANGE_ME_db_password@postgres:5432/orin?schema=public

# ── Redis (runs in this compose) ────────────────────────────
REDIS_URL=redis://redis:6379

# ── Realtime ─────────────────────────────────────────────────
# openssl rand -base64 24
REALTIME_BROADCAST_SECRET=CHANGE_ME_realtime_secret

# ── JavaScript executor (internal sandbox) ──────────────────
JAVASCRIPT_EXECUTOR_URL=http://javascript-executor:3210
# openssl rand -hex 24   (≥32 chars)
JAVASCRIPT_EXECUTOR_TOKEN=CHANGE_ME_executor_token_min_32_chars
MAX_CONCURRENCY=2

# ── Object storage (RustFS, runs in this compose) ───────────
S3_ACCESS_KEY_ID=orin
# openssl rand -hex 16
S3_SECRET_ACCESS_KEY=CHANGE_ME_s3_secret
S3_BUCKET=orin
S3_REGION=us-east-1
S3_ENDPOINT=http://filesystem:9000
# Browser-facing storage URL — goes through Caddy's /storage route.
NEXT_PUBLIC_STORAGE_URL=https://orin.stratmarkbd.com/storage/orin/

# ── SMTP (cPanel mail) ──────────────────────────────────────
# cPanel → Email Accounts → create no-reply@stratmarkbd.com → "Connect Devices"
# shows you the exact host. 587 = STARTTLS, 465 = SSL.
SMTP_SERVER=smtp://no-reply@stratmarkbd.com:CHANGE_ME@mail.stratmarkbd.com:587
SMTP_FROM=no-reply@stratmarkbd.com

# ── Public URLs (baked into the browser bundle / used by server) ──
NEXT_PUBLIC_BUILDER_URL=https://orin.stratmarkbd.com
NEXT_PUBLIC_INTERNAL_WS_URL=http://realtime:1999
NEXT_PUBLIC_INTERNAL_STORAGE_URL=http://filesystem:9000/orin/
FORCE_PUBLIC_HTTPS=true

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DEBUG=false